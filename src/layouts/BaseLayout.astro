---
import '../styles/global.css'

import ThemeToggle from '../components/ThemeToggle'
import chrome from '../content/chrome.json'
import {
  absoluteUrl,
  alternatesFor,
  DEFAULT_LOCALE,
  homePath,
  localePath,
  otherLocale,
  splitLocalePath,
  type Locale,
} from '../i18n/locales'
import { THEME_INIT_SCRIPT } from '../scripts/theme-init'

interface Props {
  title: string
  locale?: Locale
  description?: string
  noindex?: boolean
  dark?: boolean
  wide?: boolean
}

const {
  title,
  locale = 'en',
  description,
  noindex = false,
  dark = false,
  wide = false,
} = Astro.props

const copy = chrome[locale]
const year = new Date().getFullYear()
const { path } = splitLocalePath(Astro.url.pathname)
const alternates = alternatesFor(path)
const canonical = absoluteUrl(localePath(locale, path))
const switchTo = otherLocale(locale)
---

<html lang={locale} class:list={{ dark }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#f1f3f6"
      media="(prefers-color-scheme: light)"
      data-theme-color="light"
    />
    <meta
      name="theme-color"
      content="#0d1117"
      media="(prefers-color-scheme: dark)"
      data-theme-color="dark"
    />
    <script is:inline set:html={THEME_INIT_SCRIPT}></script>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={absoluteUrl(alternate.path)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(localePath(DEFAULT_LOCALE, path))}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-primary text-primary-foreground rounded-pill fixed top-3 left-3 z-50 -translate-y-20 px-4 py-2 font-mono text-xs font-medium focus:translate-y-0"
    >
      {copy.skipLink}
    </a>

    <header class="flex items-center justify-between px-4 py-4 sm:px-10 sm:py-6">
      <a
        href={homePath(locale)}
        aria-label={copy.homeLabel}
        class="text-xl font-bold tracking-tight no-underline"
      >
        {copy.wordmark}
      </a>
      <a
        href={localePath(switchTo, path)}
        hreflang={switchTo}
        lang={switchTo}
        aria-label={copy.switchAria}
        data-locale-switch={switchTo}
        class="text-muted-foreground hover:text-foreground font-mono text-xs no-underline"
      >
        {copy.switchLabel}
      </a>
      <ThemeToggle client:load copy={copy.theme} />
    </header>

    <main
      id="main"
      tabindex="-1"
      class:list={[
        'mx-auto w-full flex-1 px-4 py-8 focus:outline-none sm:px-6',
        wide ? 'max-w-[75rem]' : 'max-w-reading',
      ]}
    >
      <slot />
    </main>

    <footer class="border-border text-muted-foreground mx-auto w-full max-w-reading border-t px-4 py-6 pb-32 font-mono text-xs sm:px-6">
      <small>
        © {year} {copy.footerNote}
      </small>
    </footer>

    <div
      data-dock-slot
      class="pointer-events-none fixed inset-x-0 bottom-4 z-40 flex justify-center"
    >
      <slot name="dock" />
    </div>
  </body>
</html>

<script>
  import { rememberLocale } from '../i18n/preference'

  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Element)) return
    const link = target.closest<HTMLElement>('[data-locale-switch]')
    const locale = link?.dataset.localeSwitch
    if (locale === 'en' || locale === 'es') {
      rememberLocale(localStorage, locale)
    }
  })
</script>
