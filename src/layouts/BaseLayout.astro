---
import '../styles/global.css'

import jetbrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'

import Dock from '../components/Dock'
import chrome from '../content/chrome.json'
import home from '../content/home.json'
import {
  absoluteUrl,
  alternatesFor,
  DEFAULT_LOCALE,
  localePath,
  splitLocalePath,
  type Locale,
} from '../i18n/locales'
import {
  ANALYTICS_DOMAIN,
  UMAMI_SCRIPT_URL,
  UMAMI_WEBSITE_ID,
} from '../lib/analytics'
import { THEME_INIT_SCRIPT } from '../scripts/theme-init'
import {
  documentTitle,
  imageMetaTags,
  pageOpenGraphTags,
} from '../seo/metadata'
import { siteGraphJsonLd } from '../seo/structured-data'

interface Props {
  title: string
  locale?: Locale
  description?: string
  noindex?: boolean
  dark?: boolean
  wide?: boolean
}

const {
  title,
  locale = 'en',
  description,
  noindex = false,
  dark = false,
  wide = false,
} = Astro.props

const copy = chrome[locale]
const { path: routePath } = splitLocalePath(Astro.url.pathname)
const path = routePath === '/404/' ? '/' : routePath
const alternates = alternatesFor(path)
const canonical = absoluteUrl(localePath(locale, path))
const fullTitle = documentTitle(title, copy.wordmark)
const pageDescription = description ?? home[locale].meta.description
const socialTags = [
  ...(Astro.slots.has('head')
    ? []
    : pageOpenGraphTags({
        locale,
        title: fullTitle,
        description: pageDescription,
        url: canonical,
      })),
  ...imageMetaTags(locale, copy.ogImageAlt),
]
---

<html lang={locale} class:list={{ dark }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#f1f3f6"
      media="(prefers-color-scheme: light)"
      data-theme-color="light"
    />
    <meta
      name="theme-color"
      content="#0d1117"
      media="(prefers-color-scheme: dark)"
      data-theme-color="dark"
    />
    <script is:inline set:html={THEME_INIT_SCRIPT}></script>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex &&
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={absoluteUrl(alternate.path)}
        />
      ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={absoluteUrl(localePath(DEFAULT_LOCALE, path))}
      />
    )}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={spaceGroteskLatin}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={jetbrainsMonoLatin}
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {socialTags.map((tag) => (
      <meta property={tag.property} content={tag.content} />
    ))}
    <script
      type="application/ld+json"
      is:inline
      set:html={siteGraphJsonLd(locale, home[locale].meta.description)}
    ></script>
    <title>{fullTitle}</title>
    <script
      is:inline
      defer
      src={UMAMI_SCRIPT_URL}
      data-website-id={UMAMI_WEBSITE_ID}
      data-do-not-track="true"
      data-domains={ANALYTICS_DOMAIN}
    ></script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-primary text-primary-foreground rounded-pill fixed top-3 left-3 z-50 inline-flex min-h-11 -translate-y-20 items-center px-4 font-mono text-xs font-medium focus:translate-y-0"
    >
      {copy.skipLink}
    </a>

    <header class="site-header sticky top-0 z-30">
      <div
        class:list={[
          'mx-auto flex w-full items-center justify-between gap-4 px-4 py-4 sm:px-10 sm:py-[22px]',
          wide ? 'max-w-[75rem]' : 'max-w-reading',
        ]}
      >
        <a
          href={localePath(locale, '/')}
          class="-my-2 inline-flex min-h-11 items-center text-xl font-bold tracking-[-0.02em] no-underline"
        >
          <span>{copy.wordmarkParts[0]}</span>
          <span class="text-primary">{copy.wordmarkParts[1]}</span>
        </a>
        <span class="text-muted-foreground border-border rounded-pill inline-flex items-center gap-2 border px-3 py-1.5 font-mono text-[0.6875rem] font-medium tracking-[0.06em] whitespace-nowrap uppercase">
          <span
            class="bg-success size-[7px] rounded-full"
            aria-hidden="true"
          ></span>
          {copy.openToWork}
        </span>
      </div>
    </header>

    <main
      id="main"
      tabindex="-1"
      class:list={[
        'mx-auto grid w-full flex-1 content-start gap-7 px-4 pt-2 pb-[calc(var(--dock-height)+1rem)] focus:outline-none sm:gap-10 sm:px-10',
        wide ? 'max-w-[75rem]' : 'max-w-reading',
      ]}
    >
      <slot />
    </main>

    <div
      data-dock-slot
      class="pointer-events-none fixed inset-x-0 bottom-4 z-40 flex justify-center px-4"
    >
      <Dock
        client:interaction
        copy={copy.dock}
        themeCopy={copy.theme}
        locale={locale}
        path={path}
      />
    </div>
  </body>
</html>

<script>
  import { rememberLocale } from '../i18n/preference'

  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Element)) return
    const link = target.closest<HTMLElement>('[data-locale-switch]')
    const locale = link?.dataset.localeSwitch
    if (locale === 'en' || locale === 'es') {
      rememberLocale(localStorage, locale)
    }
  })
</script>
