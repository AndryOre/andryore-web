---
import findMe from '../content/find-me.json'
import type { Locale } from '../i18n/locales'
import { CONTACT_EMAIL } from '../lib/contact'
import { externalLinkTokens } from '../lib/external-link'
import type { IconId } from '../lib/icons'
import { resolveIcon } from '../lib/icons'
import BrandIcon from './BrandIcon.astro'
import CopyEmailButton from './CopyEmailButton'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = findMe[locale]
const emailId = 'find-me-email'

const hasDarkMark = (icon: string): boolean => {
  const { light, dark } = resolveIcon(icon as IconId)
  return light !== dark
}
---

<section
  id="find-me"
  class="flex scroll-mt-4 flex-col items-center gap-6 pt-6 pb-2 text-center"
  aria-labelledby="find-me-heading"
>
  <div class="flex flex-col gap-2">
    <h2
      id="find-me-heading"
      class="m-0 text-2xl font-bold tracking-[-0.025em] sm:text-[2rem]"
    >
      {copy.label}
    </h2>
    <p class="text-muted-foreground m-0 text-base">{copy.subline}</p>
  </div>
  <ul class="m-0 flex list-none flex-wrap justify-center gap-3.5 p-0">
    {copy.items.map((item) => (
      <li class="group relative">
        <a
          href={item.href}
          rel={externalLinkTokens()}
          aria-label={item.label}
          data-icon={item.icon}
          class="find-me-link bg-card border-border rounded-pill inline-flex size-[3.75rem] items-center justify-center border shadow-[0_10px_28px_-16px_rgb(0_0_0/0.28)] outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {hasDarkMark(item.icon) ? (
            <>
              <BrandIcon id={item.icon as IconId} class="size-7 dark:hidden" />
              <BrandIcon
                id={item.icon as IconId}
                variant="dark"
                class="hidden size-7 dark:block"
              />
            </>
          ) : (
            <BrandIcon id={item.icon as IconId} class="size-7" />
          )}
        </a>
        <span
          aria-hidden="true"
          class="bg-foreground text-background pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 translate-y-1 rounded-lg px-2.5 py-1 text-xs font-medium whitespace-nowrap opacity-0 transition duration-150 ease-out group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:transition-none"
        >
          {item.label}
        </span>
      </li>
    ))}
  </ul>
  <div
    data-email-chip
    role="group"
    aria-label={copy.emailLabel}
    class="bg-card border-border rounded-pill flex w-fit max-w-full items-center gap-1 border py-1 pr-1 pl-4 [&_[data-copy-email]]:size-11"
  >
    <span
      id={emailId}
      class="min-w-0 font-mono text-sm [overflow-wrap:anywhere] select-all"
    >
      {CONTACT_EMAIL}
    </span>
    <CopyEmailButton
      client:visible
      email={CONTACT_EMAIL}
      targetId={emailId}
      copy={{
        copyLabel: copy.copyLabel,
        copiedMessage: copy.copiedMessage,
        selectedMessage: copy.selectedMessage,
      }}
    />
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      aria-label={copy.sendLabel}
      data-send-email
      class="text-muted-foreground hover:text-foreground rounded-pill inline-flex size-11 shrink-0 items-center justify-center outline-none focus-visible:ring-2 focus-visible:ring-ring"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m22 2-7 20-4-9-9-4Z"></path>
        <path d="M22 2 11 13"></path>
      </svg>
    </a>
  </div>
</section>
