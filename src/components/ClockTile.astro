---
import tiles from '../content/live-tiles.json'
import type { Locale } from '../i18n/locales'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = tiles[locale].clock
---

<article
  data-clock
  data-greetings={JSON.stringify(copy.greetings)}
  class="bg-card border-border flex h-full min-w-0 flex-col gap-3 overflow-hidden rounded-[1.25rem] border p-5 shadow-[0_10px_28px_-16px_rgb(0_0_0/0.28)]"
>
  <p class="text-muted-foreground m-0 font-mono text-[0.6875rem] font-medium tracking-[0.08em] uppercase">
    {copy.label}
  </p>
  <p class="m-0 text-xl font-semibold tracking-[-0.02em]" data-clock-greeting>
    {copy.fallbackGreeting}
  </p>
  <p
    class="m-0 font-mono text-5xl font-bold tracking-[-0.03em] tabular-nums"
    data-clock-local
  >
    {copy.placeholder}
  </p>
  <p class="text-muted-foreground m-0 font-mono text-xs tabular-nums">
    <span class="me-1">{copy.utcLabel}</span>
    <span data-clock-utc>{copy.placeholder}</span>
  </p>
</article>

<script>
  import { startClock, type ClockParts } from '../scripts/clock-tile'

  const read = (root: HTMLElement): ClockParts | null => {
    const greeting = root.querySelector('[data-clock-greeting]')
    const local = root.querySelector('[data-clock-local]')
    const utc = root.querySelector('[data-clock-utc]')
    if (!greeting || !local || !utc || !root.dataset.greetings) return null
    return {
      greeting,
      local,
      utc,
      greetings: JSON.parse(root.dataset.greetings) as ClockParts['greetings'],
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-clock]')) {
    const parts = read(root)
    if (!parts) continue
    startClock(parts, {
      now: () => new Date(),
      setInterval: (handler, delay) => Number(setInterval(handler, delay)),
      clearInterval: (id) => {
        clearInterval(id)
      },
    })
  }
</script>
