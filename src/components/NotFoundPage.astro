---
import monocle from '../assets/afe/face-with-monocle.png'
import notFound from '../content/not-found.json'
import { homePath, localePath, type Locale } from '../i18n/locales'
import BaseLayout from '../layouts/BaseLayout.astro'
import { NOT_FOUND_TILES } from '../lib/stack-scene'
import stackSceneStylesheet from '../styles/stack-scene.css?url'
import StackTile from './StackTile.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = notFound[locale]
const [firstDigit = '4', , lastDigit = '4'] = [...copy.code]
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={locale}
  noindex
  wide
>
  <link rel="stylesheet" href={stackSceneStylesheet} />
  <section class="nf-stage">
    <div class="nf-field" aria-hidden="true">
      {NOT_FOUND_TILES.map((tile) => (
        <StackTile
          id={tile.id}
          size={tile.size}
          class:list={['nf-tile', tile.placement]}
          data-nf-delay={tile.delay}
        />
      ))}
    </div>
    <div class="nf-code" aria-hidden="true">
      <span>{firstDigit}</span>
      <span class="nf-monocle" data-sound="pop">
        <img
          src={monocle.src}
          alt=""
          width="100"
          height="6400"
          decoding="async"
        />
      </span>
      <span>{lastDigit}</span>
    </div>
    <h1 class="nf-title">{copy.heading}</h1>
    <p class="nf-message">{copy.message}</p>
    <div class="nf-actions">
      <a href={homePath(locale)} class="nf-button nf-button-primary">
        {copy.home}
      </a>
      <a
        href={localePath(locale, '/#products')}
        class="nf-button nf-button-secondary"
      >
        {copy.products}
      </a>
    </div>
  </section>
</BaseLayout>
