---
import monocle from '../assets/afe/face-with-monocle.png'
import notFound from '../content/not-found.json'
import { homePath, localePath, type Locale } from '../i18n/locales'
import BaseLayout from '../layouts/BaseLayout.astro'
import { NOT_FOUND_TILES } from '../lib/stack-scene'
import StackTile from './StackTile.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = notFound[locale]
const [firstDigit = '4', , lastDigit = '4'] = [...copy.code]
const pillClass =
  'rounded-pill inline-flex min-h-11 items-center px-5 text-sm font-medium no-underline'
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={locale}
  noindex
  wide
>
  <section class="nf-stage">
    <div class="absolute inset-0" aria-hidden="true">
      {NOT_FOUND_TILES.map((tile) => (
        <StackTile
          id={tile.id}
          size={tile.size}
          class:list={[
            'stack-tile-field nf-tile',
            tile.placement,
            !tile.mobile && 'max-md:hidden',
          ]}
        />
      ))}
    </div>
    <div class="nf-code" aria-hidden="true">
      <span>{firstDigit}</span>
      <span class="nf-monocle">
        <img
          src={monocle.src}
          alt=""
          width="100"
          height="6400"
          decoding="async"
        />
      </span>
      <span>{lastDigit}</span>
    </div>
    <h1 class="relative m-0 text-3xl leading-[1.08] font-bold tracking-[-0.03em] text-balance md:text-[2.5rem]">
      {copy.heading}
    </h1>
    <p class="text-muted-foreground relative m-0 max-w-[32ch] text-lg text-balance">
      {copy.message}
    </p>
    <div class="relative flex flex-wrap items-center justify-center gap-3">
      <a
        href={homePath(locale)}
        class={`${pillClass} bg-foreground text-background`}
      >
        {copy.home}
      </a>
      <a
        href={localePath(locale, '/#products')}
        class={`${pillClass} border-border bg-card text-foreground border`}
      >
        {copy.products}
      </a>
    </div>
  </section>
</BaseLayout>
