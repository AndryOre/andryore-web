---
import logUi from '../content/log-ui.json'
import type { Locale } from '../i18n/locales'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLogEntriesIn } from '../log/collection'
import LogList from './LogList.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const entries = await getLogEntriesIn(lang)
const copy = logUi[lang]
---

<BaseLayout title={copy.title} locale={lang} description={copy.description}>
  <LogList lang={lang} entries={entries} />
</BaseLayout>
