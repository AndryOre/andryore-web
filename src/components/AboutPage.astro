---
import { Image } from 'astro:assets'
import {
  Activity,
  CalendarDays,
  Download,
  KeyRound,
  Layers,
  Server,
  Users,
} from 'lucide-react'

import memoji from '../../docs/brand/avatar/memoji.webp'
import about from '../content/about.json'
import home from '../content/home.json'
import { localePath, type Locale } from '../i18n/locales'
import BaseLayout from '../layouts/BaseLayout.astro'
import { buildNumberStats, formatTimelineDate } from '../lib/about'
import { loadGridSnapshot } from '../lib/github-grid-build'
import type { IconId } from '../lib/icons'
import CvSplitButton from './CvSplitButton'
import UsesBadge from './UsesBadge.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = about[locale]
const installs = home[locale].products.contribution
const snapshot = await loadGridSnapshot()
const stats = buildNumberStats(
  copy,
  {
    installs: { total: installs.metaTotal, date: installs.metaDate },
    contributions: snapshot?.total ?? null,
  },
  locale,
)
const whatIcons = {
  layers: Layers,
  'key-round': KeyRound,
  server: Server,
} as const
const statIcons = {
  independent: CalendarDays,
  snug: Users,
  installs: Download,
  contributions: Activity,
} as const
const [firstPhrase = ''] = copy.typingPhrases
const longestPhrase = copy.typingPhrases.toSorted(
  (a, b) => b.length - a.length,
)[0]

const tileClass =
  'bg-card border-border flex min-w-0 flex-col gap-3 rounded-[1.25rem] border p-5'
const iconTileClass =
  'bg-secondary text-primary border-border flex size-10 shrink-0 items-center justify-center rounded-xl border'
const headingClass = 'm-0 text-2xl font-bold tracking-[-0.025em]'
---

<BaseLayout
  title={copy.pageTitle}
  description={copy.pageDescription}
  locale={locale}
>
  <div class="flex flex-col gap-12 sm:gap-14">
    <section
      aria-labelledby="about-heading"
      class="bg-card border-border flex flex-col items-start gap-6 rounded-[1.25rem] border p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-8"
    >
      <Image
        src={memoji}
        alt=""
        width={200}
        height={200}
        loading="eager"
        class="bg-secondary border-border size-[100px] shrink-0 rounded-[22px] border object-contain p-1.5"
      />
      <div class="flex min-w-0 flex-col gap-3.5">
        <p class="text-muted-foreground m-0 font-mono text-[0.6875rem] font-medium tracking-[0.08em] uppercase">
          {copy.kicker}
        </p>
        <h1
          id="about-heading"
          aria-label={`${copy.typingPrefix}${firstPhrase}`}
          data-typing
          data-typing-phrases={JSON.stringify(copy.typingPhrases)}
          class="m-0 text-3xl leading-[1.1] font-bold tracking-[-0.03em] text-balance sm:text-4xl"
        >
          <span aria-hidden="true">
            {copy.typingPrefix}
            <span class="inline-grid">
              <span class="invisible col-start-1 row-start-1 whitespace-pre-wrap">
                {longestPhrase}
                <span class="caret caret-em"></span>
              </span>
              <span class="col-start-1 row-start-1">
                <span data-typing-text>{firstPhrase}</span>
                <span class="caret caret-em"></span>
              </span>
            </span>
          </span>
        </h1>
        <p class="text-muted-foreground m-0 text-base sm:text-[1.0625rem]">
          {copy.subline}
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <CvSplitButton client:load locale={locale} copy={copy} />
          <span class="bg-secondary border-border inline-flex min-h-8 items-center rounded-full border px-3 font-mono text-[0.6875rem] font-medium tracking-[0.06em] uppercase">
            {copy.openTo}
          </span>
        </div>
      </div>
    </section>

    <section aria-labelledby="what-i-do-heading" class="flex flex-col gap-4">
      <h2 id="what-i-do-heading" class={headingClass}>
        {copy.whatIDo.heading}
      </h2>
      <ul class="m-0 grid list-none gap-4 p-0 md:grid-cols-3">
        {copy.whatIDo.items.map((item) => {
          const Icon = whatIcons[item.icon as keyof typeof whatIcons]
          return (
            <li class={tileClass} data-what-i-do={item.key}>
              <span class={iconTileClass}>
                <Icon aria-hidden="true" size={20} />
              </span>
              <h3 class="m-0 text-lg font-semibold tracking-tight">
                {item.title}
              </h3>
              <p class="text-muted-foreground m-0 text-sm">{item.body}</p>
            </li>
          )
        })}
      </ul>
    </section>

    <section aria-labelledby="numbers-heading" class="flex flex-col gap-4">
      <h2 id="numbers-heading" class={headingClass}>
        {copy.numbersHeading}
      </h2>
      <dl class="m-0 grid grid-cols-2 gap-4 md:grid-cols-4" data-about-numbers>
        {stats.map((stat) => {
          const Icon = statIcons[stat.key]
          return (
            <div
              class={tileClass}
              data-stat={stat.key}
              data-about-live={stat.key === 'contributions' ? '' : undefined}
              data-locale={locale}
            >
              <span class={iconTileClass}>
                <Icon aria-hidden="true" size={20} />
              </span>
              <dd class="m-0 flex flex-col gap-1">
                <span class="text-3xl font-bold tracking-[-0.03em] tabular-nums">
                  {stat.count === undefined ? (
                    stat.display
                  ) : (
                    <span
                      data-count-total={stat.count}
                      data-count-locale={locale}
                    >
                      {stat.display}
                    </span>
                  )}
                  {stat.suffix}
                </span>
                {stat.note && (
                  <span class="text-muted-foreground font-mono text-xs">
                    {stat.note}
                  </span>
                )}
              </dd>
              <dt class="text-muted-foreground order-last text-sm">
                {stat.label}
              </dt>
            </div>
          )
        })}
      </dl>
    </section>

    <section aria-labelledby="timeline-heading" class="flex flex-col gap-4">
      <h2 id="timeline-heading" class={headingClass}>
        {copy.timelineHeading}
      </h2>
      <ol class="border-border m-0 flex list-none flex-col gap-6 border-l p-0 pl-6">
        {copy.timeline.map((entry) => (
          <li class="relative flex flex-col gap-1">
            <span
              class="bg-primary absolute top-[0.45rem] -left-[1.8125rem] size-2 rounded-full"
              aria-hidden="true"
            />
            <time
              datetime={entry.date}
              class="text-muted-foreground font-mono text-xs tabular-nums"
            >
              {formatTimelineDate(entry.date, locale)}
            </time>
            <span class="font-semibold">{entry.title}</span>
            <span class="text-muted-foreground text-sm">{entry.body}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="flex flex-col gap-5" data-about-closing>
      <div class="flex max-w-[65ch] flex-col gap-4">
        {copy.bio.map((paragraph) => (
          <p class="m-0">{paragraph}</p>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0">
          {copy.stack.map((item) => (
            <li>
              <UsesBadge
                badge={{ name: item.name, icon: item.icon as IconId }}
              />
            </li>
          ))}
        </ul>
        <a
          href={localePath(locale, '/uses/')}
          class="text-muted-foreground hover:text-foreground inline-flex min-h-11 items-center font-mono text-xs underline underline-offset-4"
        >
          {copy.stackLink}
          <span aria-hidden="true">&nbsp;→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { prefersReducedMotion } from '../lib/motion'
  import { startCountUp } from '../scripts/count-up'
  import { mountGithubTile } from '../scripts/github-tile'
  import { startPhraseTyping } from '../scripts/typing-headline'

  const reducedMotion = prefersReducedMotion(globalThis)

  for (const root of document.querySelectorAll<HTMLElement>('[data-typing]')) {
    const target = root.querySelector<HTMLElement>('[data-typing-text]')
    const phrases: unknown = JSON.parse(root.dataset.typingPhrases ?? '[]')
    if (
      target &&
      Array.isArray(phrases) &&
      phrases.every((phrase) => typeof phrase === 'string')
    ) {
      startPhraseTyping(target, phrases, {
        reducedMotion,
        random: () => Math.random(),
        schedule: (callback, delay) => setTimeout(callback, delay),
        cancel: (handle) => {
          clearTimeout(handle)
        },
      })
    }
  }

  const countUp = (target: HTMLElement): void => {
    const total = Number(target.dataset.countTotal)
    if (!Number.isFinite(total)) return
    startCountUp(target, total, {
      reducedMotion,
      locale: target.dataset.countLocale ?? 'en',
      requestFrame: (callback) => requestAnimationFrame(callback),
    })
  }

  for (const target of document.querySelectorAll<HTMLElement>(
    '[data-about-numbers] [data-count-total]:not([data-about-live] *)',
  )) {
    countUp(target)
  }

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-about-live]',
  )) {
    const targets = [
      ...root.querySelectorAll<HTMLElement>('[data-count-total]'),
    ]
    const countedTotals = targets.map((target) => {
      countUp(target)
      return target.dataset.countTotal
    })
    void mountGithubTile(root).then(() => {
      for (const [index, target] of targets.entries()) {
        const total = Number(target.dataset.countTotal)
        if (
          target.dataset.countTotal === countedTotals[index] ||
          !Number.isFinite(total)
        )
          continue
        target.textContent = new Intl.NumberFormat(
          target.dataset.countLocale ?? 'en',
        ).format(total)
      }
    })
  }
</script>
