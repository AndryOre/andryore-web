---
import { Image } from 'astro:assets'

import memoji from '../../docs/brand/avatar/memoji.webp'
import chrome from '../content/chrome.json'
import home from '../content/home.json'
import type { Locale } from '../i18n/locales'
import { externalLinkAttributes } from '../lib/external-link'
import { SESSION_WEEKDAYS } from '../lib/stream-state'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = home[locale]
const stream = copy.stream

const weekStrip = stream.weekdays.map((letter, column) => ({
  letter,
  column,
  session: SESSION_WEEKDAYS.includes((column + 1) % 7),
}))

const CALENDAR_DAYS_ICON =
  '<path d="M8 2v3"/><path d="M16 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M8 13h.01"/><path d="M12 13h.01"/><path d="M16 13h.01"/><path d="M8 17h.01"/><path d="M12 17h.01"/><path d="M16 17h.01"/>'
const CLOCK_ICON = '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>'

const ctas = [
  { show: 'coming-soon', label: stream.follow },
  { show: 'scheduled unavailable', label: stream.open },
  { show: 'live', label: stream.watch },
]

const TWITCH_GLYPH =
  'M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z'
---

<article
  data-stream-tile
  data-state="coming-soon"
  data-started={String(stream.streamsStarted)}
  data-locale={locale}
  data-cd-in={stream.countdownIn}
  data-cd-day={stream.countdownDay}
  data-cd-hour={stream.countdownHour}
  data-cd-minute={stream.countdownMinute}
  class="stream-tile bg-card border-border relative flex h-full min-w-0 flex-col overflow-hidden rounded-[1.25rem] border"
>
  <div class="stream-inner flex flex-1 flex-col gap-3">
    <p class="stream-head">
      <span class="stream-who">
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="#9146ff"
          aria-hidden="true"
        >
          <path d={TWITCH_GLYPH}></path>
        </svg>
        {stream.handle}
      </span>
      <span data-show="live" class="stream-badge stream-badge-live">
        <i aria-hidden="true"></i>
        {stream.liveTag}
      </span>
      <span data-show="coming-soon" class="stream-badge">
        {stream.badgeComingSoon}
      </span>
      <span data-show="scheduled" class="stream-badge">
        {stream.badgeOffline}
      </span>
      <span data-show="unavailable" class="stream-badge">
        {stream.badgeUnavailable}
      </span>
    </p>

    <div class="stream-screen" data-stream-screen>
      <div data-show="live" class="stream-screen-copy">
        <span class="stream-play" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M7 4l13 8-13 8z"></path>
          </svg>
        </span>
        <p data-stream-title class="stream-cap">
          {stream.liveCaption}
        </p>
      </div>
      <div
        data-show="coming-soon scheduled unavailable"
        class="stream-screen-copy"
      >
        <Image
          src={memoji}
          alt=""
          width={44}
          height={44}
          class="stream-memoji"
        />
        <p data-show="coming-soon" class="stream-screen-title">
          {stream.comingSoon}
        </p>
        <p data-show="coming-soon" class="stream-screen-sub">
          {stream.planned}
        </p>
        <p data-show="scheduled" class="stream-screen-title">
          {stream.offlineNow}
        </p>
        <p data-show="scheduled" class="stream-screen-sub">
          {stream.screenOffline}
        </p>
        <p data-show="unavailable" class="stream-screen-title">
          {stream.unavailable}
        </p>
        <p data-show="unavailable" class="stream-screen-sub">
          {stream.unavailableSub}
        </p>
      </div>
    </div>

    <ol
      class="stream-week"
      data-show="coming-soon scheduled"
      aria-label={stream.weekLabel}
    >
      {weekStrip.map((day) => (
        <li
          data-stream-day={day.column}
          data-session={String(day.session)}
          class="stream-day"
        >
          {day.letter}
          {day.session && <i>{stream.sessionHour}</i>}
        </li>
      ))}
    </ol>

    <p data-show="coming-soon" class="stream-line">
      <svg
        viewBox="0 0 24 24"
        class="stream-line-icon"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={CALENDAR_DAYS_ICON}
      />
      <span>{stream.plannedLabel}</span>
      <strong>{stream.plannedValue}</strong>
    </p>
    <p data-show="scheduled" class="stream-line">
      <svg
        viewBox="0 0 24 24"
        class="stream-line-icon"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={CLOCK_ICON}
      />
      <span>{stream.nextLabel}</span>
      <strong data-stream-next>&nbsp;</strong>
    </p>

    {ctas.map((cta) => (
      <a
        href={stream.href}
        {...externalLinkAttributes(stream.href)}
        class="stream-cta"
        data-show={cta.show}
      >
        <svg
          viewBox="0 0 24 24"
          class="stream-cta-glyph"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={TWITCH_GLYPH} />
        </svg>
        {cta.label}
        <span class="sr-only">{chrome[locale].opensInNewTab}</span>
      </a>
    ))}
  </div>
</article>

<script>
  import { soundTriggers } from '../scripts/sound-triggers'
  import {
    COUNTDOWN_INTERVAL_MS,
    mountStreamTile,
    refreshCountdown,
  } from '../scripts/stream-tile'

  for (const tile of document.querySelectorAll<HTMLElement>(
    '[data-stream-tile]',
  )) {
    void mountStreamTile(tile, undefined, new Date(), () => {
      soundTriggers.playUnlocked('live')
    }).then(() => {
      if (tile.dataset.state !== 'scheduled') return
      setInterval(() => {
        refreshCountdown(tile, new Date())
      }, COUNTDOWN_INTERVAL_MS)
    })
  }
</script>
