---
import { Image } from 'astro:assets'

import memoji from '../../docs/brand/avatar/memoji.webp'
import home from '../content/home.json'
import type { Locale } from '../i18n/locales'
import { externalLinkTokens } from '../lib/external-link'
import { SESSION_WEEKDAYS } from '../lib/stream-state'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = home[locale]
const stream = copy.stream

const weekStrip = stream.weekdays.map((letter, column) => ({
  letter,
  column,
  session: SESSION_WEEKDAYS.includes((column + 1) % 7),
}))

const TWITCH_GLYPH =
  'M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z'
---

<article
  data-stream-tile
  data-state="coming-soon"
  data-started={String(stream.streamsStarted)}
  data-locale={locale}
  data-cd-in={stream.countdownIn}
  data-cd-day={stream.countdownDay}
  data-cd-hour={stream.countdownHour}
  data-cd-minute={stream.countdownMinute}
  class="stream-tile bg-card border-border relative flex h-full min-w-0 flex-col overflow-hidden rounded-[1.25rem] border"
>
  <div class="h-1 shrink-0 bg-[#9146ff]" aria-hidden="true"></div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="stream-head">
      <span class="stream-who">
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="#9146ff"
          aria-hidden="true"
        >
          <path d={TWITCH_GLYPH}></path>
        </svg>
        {stream.handle}
      </span>
      <span data-show="live" class="stream-badge stream-badge-live">
        <i aria-hidden="true"></i>
        {stream.liveTag}
      </span>
      <span data-show="coming-soon" class="stream-badge">
        {stream.badgeComingSoon}
      </span>
      <span data-show="scheduled" class="stream-badge">
        {stream.badgeOffline}
      </span>
      <span data-show="unavailable" class="stream-badge">
        {stream.badgeUnavailable}
      </span>
    </p>

    <div class="stream-screen" data-stream-screen>
      <div data-show="live" class="stream-screen-copy">
        <span class="stream-play" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </span>
        <p data-stream-title class="stream-screen-title"></p>
      </div>
      <div
        data-show="coming-soon scheduled unavailable"
        class="stream-screen-copy"
      >
        <Image
          src={memoji}
          alt={stream.slateAlt}
          width={44}
          height={44}
          class="stream-memoji"
        />
        <p data-show="coming-soon" class="stream-screen-title">
          {stream.comingSoon}
        </p>
        <p data-show="coming-soon" class="stream-screen-sub">
          {stream.planned}
        </p>
        <p data-show="scheduled" class="stream-screen-title">
          {stream.screenOffline}
        </p>
        <p data-show="unavailable" class="stream-screen-title">
          {stream.unavailable}
        </p>
      </div>
    </div>

    <ol class="stream-week" aria-label={stream.weekLabel}>
      {weekStrip.map((day) => (
        <li
          data-stream-day={day.column}
          data-session={String(day.session)}
          class="stream-day"
        >
          {day.letter}
          {day.session && <i>{stream.sessionHour}</i>}
        </li>
      ))}
    </ol>

    <p data-show="coming-soon" class="stream-line">
      {stream.plannedLine}
    </p>
    <p data-show="scheduled" class="stream-line">
      {stream.nextLabel}
      <strong data-stream-next>&nbsp;</strong>
      <span data-stream-countdown>&nbsp;</span>
    </p>

    <a
      href={stream.href}
      rel={externalLinkTokens()}
      class="stream-cta"
      data-show="coming-soon scheduled unavailable"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-4"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={TWITCH_GLYPH}></path>
      </svg>
      {stream.follow}
    </a>
    <a
      href={stream.href}
      rel={externalLinkTokens()}
      class="stream-cta"
      data-show="live"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-4"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={TWITCH_GLYPH}></path>
      </svg>
      {stream.watch}
    </a>
  </div>
</article>

<script>
  import {
    COUNTDOWN_INTERVAL_MS,
    mountStreamTile,
    refreshCountdown,
  } from '../scripts/stream-tile'

  for (const tile of document.querySelectorAll<HTMLElement>(
    '[data-stream-tile]',
  )) {
    void mountStreamTile(tile).then(() => {
      if (tile.dataset.state !== 'scheduled') return
      setInterval(() => {
        refreshCountdown(tile, new Date())
      }, COUNTDOWN_INTERVAL_MS)
    })
  }
</script>
