---
import { FIELD_ICONS, floatClass } from '../lib/uses'
import BrandIcon from './BrandIcon.astro'
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0">
  {FIELD_ICONS.map((icon, index) => (
    <span
      class:list={[
        'border-border bg-card absolute flex items-center justify-center rounded-[24%] border shadow-md',
        icon.placement,
        floatClass(index),
      ]}
    >
      <BrandIcon id={icon.id} class="size-1/2 dark:hidden" />
      <BrandIcon
        id={icon.id}
        variant="dark"
        class="hidden size-1/2 dark:block"
      />
    </span>
  ))}
</div>
