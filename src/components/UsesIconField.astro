---
import { FIELD_ICONS, floatClass } from '../lib/uses'
import BrandIcon from './BrandIcon.astro'
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
  {FIELD_ICONS.map((icon, index) => (
    <span
      class:list={[
        'absolute opacity-40 sm:opacity-50',
        icon.placement,
        floatClass(index),
      ]}
    >
      <BrandIcon id={icon.id} class="size-8 sm:size-10" />
    </span>
  ))}
</div>
