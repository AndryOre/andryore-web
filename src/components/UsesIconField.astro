---
import { FIELD_ICONS, floatClass } from '../lib/uses'

const ICON_PATHS: Readonly<Record<string, string>> = {
  keyboard:
    'M3 6h18a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1ZM6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10',
  monitor: 'M3 4h18v12H3ZM8 20h8M12 16v4',
  mouse: 'M12 3a5 5 0 0 1 5 5v8a5 5 0 0 1-10 0V8a5 5 0 0 1 5-5ZM12 7v4',
  headphones:
    'M4 15v-3a8 8 0 0 1 16 0v3M4 15h3v5H5a1 1 0 0 1-1-1ZM20 15h-3v5h2a1 1 0 0 0 1-1Z',
  microphone:
    'M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3ZM5 11a7 7 0 0 0 14 0M12 18v3',
  camera:
    'M4 7h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1ZM12 10a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z',
  laptop: 'M5 5h14v10H5ZM2 19h20',
  terminal:
    'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1ZM7 10l3 2-3 2M12 15h5',
  cup: 'M5 8h11v6a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5ZM16 10h2a2 2 0 0 1 0 4h-2M8 3v2M12 3v2',
  chip: 'M7 7h10v10H7ZM10 10h4v4h-4ZM10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4',
}
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
  {FIELD_ICONS.map((icon, index) => (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
      class:list={[
        'text-muted-foreground absolute size-8 opacity-50 sm:size-10',
        icon.placement,
        floatClass(index),
      ]}
    >
      <path d={ICON_PATHS[icon.id] ?? ''} />
    </svg>
  ))}
</div>
