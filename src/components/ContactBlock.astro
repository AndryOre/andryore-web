---
import contact from '../content/contact.json'
import type { Locale } from '../i18n/locales'
import { CONTACT_EMAIL } from '../lib/contact'
import CopyEmailButton from './CopyEmailButton'

interface Props {
  locale: Locale
  idSuffix: string
  showOpenTo?: boolean
}

const { locale, idSuffix, showOpenTo = false } = Astro.props
const copy = contact[locale]
const emailId = `contact-email-${idSuffix}`
---

<section
  aria-labelledby={`contact-heading-${idSuffix}`}
  class="flex flex-col gap-3"
>
  <h2 id={`contact-heading-${idSuffix}`} class="m-0 text-base font-semibold">
    {copy.contactHeading}
  </h2>
  <p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-muted-foreground font-mono text-xs">
      {copy.emailLabel}
    </span>
    <span
      id={emailId}
      class="min-w-0 font-mono text-sm [overflow-wrap:anywhere] select-all"
    >
      {CONTACT_EMAIL}
    </span>
  </p>
  <CopyEmailButton
    client:visible
    email={CONTACT_EMAIL}
    targetId={emailId}
    copy={{
      copyLabel: copy.copyLabel,
      copiedMessage: copy.copiedMessage,
      selectedMessage: copy.selectedMessage,
    }}
  />
  {showOpenTo && <p class="m-0 text-sm">{copy.openTo}</p>}
</section>
