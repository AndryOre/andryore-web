---
import tiles from '../content/live-tiles.json'
import type { Locale } from '../i18n/locales'
import type { GridSnapshot } from '../lib/github-grid'
import {
  computeStats,
  gridCellsHtml,
  statsView,
  updatedLabel,
} from '../lib/github-stats'

interface Props {
  locale: Locale
  snapshot: GridSnapshot
}

const { locale, snapshot } = Astro.props
const copy = tiles[locale].github
const total = new Intl.NumberFormat(locale).format(snapshot.total)
const view = statsView(computeStats(snapshot), locale, {
  one: copy.dayOne,
  other: copy.dayOther,
})
const updated = updatedLabel(
  copy.updatedLabel,
  snapshot.capturedAt,
  new Date(),
  locale,
)
const legend = [0, 1, 2, 3] as const
const stats = [
  { key: 'longest', label: copy.longestStreak, value: view.longest },
  { key: 'current', label: copy.currentStreak, value: view.current },
] as const
---

<article
  data-github-grid
  data-locale={locale}
  data-captured-at={snapshot.capturedAt}
  data-updated-prefix={copy.updatedLabel}
  data-grid-label={copy.gridLabel}
  data-day-one={copy.dayOne}
  data-day-other={copy.dayOther}
  class="github-tile bg-card border-border flex h-full min-w-0 flex-col gap-3 overflow-hidden rounded-[1.25rem] border p-5"
>
  <p class="text-muted-foreground m-0 flex items-center justify-between gap-3 font-mono text-[0.6875rem] font-medium tracking-[0.08em] uppercase">
    <span>{copy.label}</span>
    <time
      class="normal-case tabular-nums"
      data-gh-updated
      datetime={snapshot.capturedAt}
    >
      {updated}
    </time>
  </p>
  <p class="m-0 flex flex-wrap items-baseline gap-x-2">
    <span
      class="text-4xl font-bold tracking-[-0.03em] tabular-nums"
      data-count-total={snapshot.total}
      data-count-locale={locale}
    >
      {total}
    </span>
    <span class="text-muted-foreground text-sm">{copy.totalLabel}</span>
  </p>
  <div
    role="img"
    aria-label={`${copy.gridLabel}: ${total}`}
    data-gh-grid
    class="github-grid grid auto-cols-fr grid-flow-col grid-rows-7 gap-[2px]"
    set:html={gridCellsHtml(snapshot.weeks)}
  />
  <div
    class="text-muted-foreground flex items-center justify-end gap-1.5 font-mono text-[0.625rem] uppercase"
    aria-hidden="true"
  >
    <span>{copy.less}</span>
    {legend.map((level) => (
      <i class="github-legend" data-level={level} />
    ))}
    <span>{copy.more}</span>
  </div>
  <dl class="m-0 mt-auto grid grid-cols-2 gap-2" aria-label={copy.statsLabel}>
    {stats.map((stat) => (
      <div class="bg-muted/50 border-border grid gap-0.5 rounded-xl border px-3 py-2">
        <dt class="text-muted-foreground font-mono text-[0.625rem] uppercase tracking-[0.04em]">
          {stat.label}
        </dt>
        <dd
          class="github-stat m-0 text-lg font-bold tracking-[-0.02em] tabular-nums"
          data-gh-stat={stat.key}
        >
          {stat.value}
        </dd>
      </div>
    ))}
    <div class="bg-muted/50 border-border grid gap-0.5 rounded-xl border px-3 py-2">
      <dt class="text-muted-foreground font-mono text-[0.625rem] uppercase tracking-[0.04em]">
        {copy.bestDay}
      </dt>
      <dd class="m-0 text-lg font-bold tracking-[-0.02em] tabular-nums">
        <span class="github-stat" data-gh-stat="best">
          {view.best}
        </span>
        <small class="text-muted-foreground font-mono text-[0.6875rem] font-medium">
          {copy.bestDayUnit}
          <span data-gh-stat="best-date">{view.bestDate}</span>
        </small>
      </dd>
    </div>
    <div class="bg-muted/50 border-border grid gap-0.5 rounded-xl border px-3 py-2">
      <dt class="text-muted-foreground font-mono text-[0.625rem] uppercase tracking-[0.04em]">
        {copy.activeDays}
      </dt>
      <dd
        class="github-stat m-0 text-lg font-bold tracking-[-0.02em] tabular-nums"
        data-gh-stat="active"
      >
        {view.active}
      </dd>
    </div>
  </dl>
</article>

<script>
  import { prefersReducedMotion } from '../lib/motion'
  import { startCountUp } from '../scripts/count-up'
  import { mountGithubTile } from '../scripts/github-tile'

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-github-grid]',
  )) {
    void mountGithubTile(root).then(() => {
      for (const target of root.querySelectorAll<HTMLElement>(
        '[data-count-total]',
      )) {
        const total = Number(target.dataset.countTotal)
        if (!Number.isFinite(total)) continue
        startCountUp(target, total, {
          reducedMotion: prefersReducedMotion(globalThis),
          locale: target.dataset.countLocale ?? 'en',
          requestFrame: (callback) => requestAnimationFrame(callback),
        })
      }
    })
  }
</script>
