---
import chrome from '../content/chrome.json'
import type { Locale } from '../i18n/locales'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLogEntries, type LogEntry } from '../log/collection'
import { counterpartOf, entriesIn, neighboursOf } from '../log/entries'
import { articleJsonLd, openGraphTags } from '../log/seo'
import LogEntryPage from './LogEntryPage.astro'

interface Props {
  lang: Locale
  entry: LogEntry
}

const { lang, entry } = Astro.props
const all = await getLogEntries()
const { previous, next } = neighboursOf(entriesIn(all, lang), entry)
const counterpart = counterpartOf(all, entry)
---

<BaseLayout
  title={`${entry.title} | ${chrome[lang].wordmark}`}
  locale={lang}
  description={entry.description}
>
  <Fragment slot="head">
    {openGraphTags(entry).map((tag) => (
      <meta property={tag.property} content={tag.content} />
    ))}
    <script
      type="application/ld+json"
      is:inline
      set:html={articleJsonLd(entry)}
    ></script>
  </Fragment>
  <LogEntryPage
    lang={lang}
    entry={entry}
    counterpart={counterpart}
    previous={previous}
    next={next}
  />
</BaseLayout>
