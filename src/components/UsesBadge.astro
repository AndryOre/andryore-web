---
import { badgeStyle, type UsesBadge } from '../lib/uses'
import BrandIcon from './BrandIcon.astro'

interface Props {
  badge: UsesBadge
}

const { badge } = Astro.props
const style = badgeStyle(badge.icon)
const tone = [
  'inline-flex h-[34px] items-center gap-2 rounded-[6px] pr-3 pl-2.5 font-mono text-xs font-bold tracking-[0.06em] whitespace-nowrap uppercase no-underline',
  style.bg,
  style.text,
]
---

{badge.url ? (
  <a
    href={badge.url}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      tone,
      'group transition-transform duration-150 hover:-translate-y-0.5 focus-visible:-translate-y-0.5',
    ]}
  >
    <BrandIcon id={badge.icon} class:list={['size-4 flex-none', style.logo]} />
    <span>{badge.name}</span>
    <span
      aria-hidden="true"
      class="w-0 overflow-hidden text-[11px] font-normal not-italic opacity-0 transition-[opacity,width] duration-150 group-hover:w-[11px] group-hover:opacity-80 group-focus-visible:w-[11px] group-focus-visible:opacity-80"
    >
      ↗
    </span>
  </a>
) : (
  <span class:list={tone}>
    <BrandIcon id={badge.icon} class:list={['size-4 flex-none', style.logo]} />
    <span>{badge.name}</span>
  </span>
)}
