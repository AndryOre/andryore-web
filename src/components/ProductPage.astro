---
import { Picture } from 'astro:assets'
import { getCollection, render } from 'astro:content'

import productUi from '../content/product-ui.json'
import type { Locale } from '../i18n/locales'
import { localePath } from '../i18n/locales'
import BaseLayout from '../layouts/BaseLayout.astro'
import { ANALYTICS_EVENTS, analyticsAttributes } from '../lib/analytics'
import { externalLinkTokens } from '../lib/external-link'
import { revealClass } from '../lib/motion'
import {
  fillPlaceholder,
  formatProofDate,
  headerLinks,
  SKIN_TONE_CLASSES,
  stackBadgeClass,
  stackIconId,
  type HeaderLinkId,
  type ProductEntry,
} from '../lib/products'
import ProductIcon from './ProductIcon.astro'

interface Props {
  locale: Locale
  productKey: string
}

const { locale, productKey } = Astro.props
const ui = productUi[locale]

const entries: ProductEntry[] = await getCollection('products')
const entry = entries.find(
  (candidate) =>
    candidate.data.lang === locale && candidate.data.key === productKey,
)
if (!entry) {
  throw new Error(`No "${locale}" product entry for "${productKey}".`)
}
const { data } = entry
const { Content } = await render(entry)
const isContribution = data.kind === 'contribution'

const linkIcons: Record<HeaderLinkId, string> = {
  website: 'globe',
  source: 'github',
  npm: 'package',
  marketplace: 'puzzle',
}
const links = headerLinks(data)

const sectionClass = 'flex flex-col gap-3'
const headingClass =
  'text-muted-foreground m-0 font-mono text-xs font-normal tracking-widest uppercase'
const chipClass =
  'border-border bg-card rounded-pill inline-flex min-h-9 items-center gap-2 border px-3 py-1 text-sm no-underline'
const cardClass =
  'border-border bg-card rounded-card flex flex-col gap-2 border p-5'
interface Chip {
  icon: string
  label: string
  href?: string | undefined
}
interface ChipGroup {
  heading: string
  items: Chip[]
}
const sourceGroups: ChipGroup[] = [
  {
    heading: data.skinTones ? ui.frameworks : ui.worksWith,
    items: data.platforms,
  },
  { heading: ui.importsFrom, items: data.importsFrom },
].filter((group) => group.items.length > 0)
const formatGroups: ChipGroup[] = [
  { heading: ui.exportFormats, items: data.exportFormats },
  { heading: ui.importFormats, items: data.importFormats },
].filter((group) => group.items.length > 0)
const hasFormatsCard = sourceGroups.length > 0 || formatGroups.length > 0
const heroChips: Chip[] =
  data.exportFormats.length > 0 ? data.exportFormats : data.platforms
const backHref = localePath(locale, '/#products')
---

<BaseLayout
  title={`${data.name} · AndryOre`}
  locale={locale}
  description={data.description}
>
  <article class="flex flex-col gap-10">
    <header class:list={['reveal', revealClass(0), 'flex flex-col gap-4']}>
      <a
        href={backHref}
        class="text-muted-foreground hover:text-foreground inline-flex min-h-11 w-fit items-center gap-2 font-mono text-xs tracking-wide no-underline"
        data-product-back
      >
        <span aria-hidden="true">←</span>
        {ui.backLink}
      </a>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="m-0 min-w-0 text-4xl font-bold tracking-tight [overflow-wrap:anywhere]">
          {data.name}
        </h1>
        <span
          class:list={[
            'rounded-pill inline-flex shrink-0 items-center gap-2 border px-3 py-1 font-mono text-xs tracking-wider whitespace-nowrap uppercase',
            data.state === 'live'
              ? 'border-success/40 bg-success/10 text-success'
              : 'border-border text-muted-foreground',
          ]}
          data-product-state={data.state}
        >
          {data.state === 'live' && (
            <span
              class="bg-success size-[7px] rounded-full"
              aria-hidden="true"
            />
          )}
          {ui.state[data.state]}
        </span>
        {data.tag && (
          <span
            class="bg-muted text-muted-foreground rounded-pill shrink-0 px-3 py-1 font-mono text-xs whitespace-nowrap"
            data-product-tag
          >
            {data.tag}
          </span>
        )}
      </div>
      <p class="text-muted-foreground m-0 text-lg [overflow-wrap:anywhere]">
        {data.value}
      </p>
      <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              rel={externalLinkTokens()}
              {...analyticsAttributes(ANALYTICS_EVENTS.productOpen, {
                product: data.key,
                link: link.id,
              })}
              class:list={[
                'rounded-pill inline-flex min-h-11 items-center gap-2 px-5 py-2 text-sm font-medium no-underline',
                link.id === 'website'
                  ? 'bg-primary text-primary-foreground hover:opacity-90'
                  : 'border-border bg-card hover:bg-muted border',
              ]}
            >
              <ProductIcon name={linkIcons[link.id]} />
              {ui.links[link.id]}
            </a>
          </li>
        ))}
      </ul>
    </header>

    <section
      class:list={[
        'reveal',
        revealClass(1),
        'border-border bg-card rounded-card flex flex-col items-center gap-6 border p-6 sm:p-8',
      ]}
      aria-label={ui.heroLabel}
      data-product-hero
    >
      <Picture
        src={data.image.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[240, 480]}
        sizes="240px"
        class="border-border size-40 rounded-[2rem] border object-cover sm:size-48"
      />
      {heroChips.length > 0 && (
        <ul class="m-0 flex list-none flex-wrap justify-center gap-2 p-0">
          {heroChips.map((item) => (
            <li class={chipClass}>
              <ProductIcon name={item.icon} />
              {item.label}
            </li>
          ))}
        </ul>
      )}
    </section>

    {data.stats.length > 0 && (
      <section
        class:list={['reveal', revealClass(2), sectionClass]}
        aria-label={ui.statsHeading}
      >
        <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 min-[480px]:grid-cols-2 min-[900px]:grid-cols-4">
          {data.stats.map((stat) => (
            <li
              class="border-border bg-card rounded-card flex flex-col gap-1 border p-4"
              data-product-stat
            >
              <ProductIcon
                name={stat.icon}
                size={18}
                class="text-muted-foreground"
              />
              <span class="font-mono text-2xl tabular-nums [overflow-wrap:anywhere]">
                {stat.value}
              </span>
              <span class="text-muted-foreground text-sm">{stat.label}</span>
              {stat.date && (
                <time
                  class="text-muted-foreground font-mono text-xs"
                  datetime={stat.date}
                >
                  {fillPlaceholder(
                    ui.proofAsOf,
                    'date',
                    formatProofDate(stat.date, locale),
                  )}
                </time>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {hasFormatsCard && (
      <section
        class:list={['reveal', revealClass(3), cardClass, 'gap-6']}
        data-product-formats
      >
        {sourceGroups.length > 0 && (
          <div class="flex flex-col gap-5">
            {sourceGroups.map((group) => (
              <div class={sectionClass}>
                <h2 class={headingClass}>{group.heading}</h2>
                <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                  {group.items.map((item) => (
                    <li>
                      {item.href ? (
                        <a
                          href={item.href}
                          rel={externalLinkTokens()}
                          class={chipClass}
                        >
                          <ProductIcon name={item.icon} />
                          {item.label}
                        </a>
                      ) : (
                        <span class={chipClass}>
                          <ProductIcon name={item.icon} />
                          {item.label}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
        {formatGroups.length > 0 && (
          <div class="border-border grid grid-cols-1 gap-6 border-t pt-6 min-[640px]:grid-cols-2">
            {formatGroups.map((group) => (
              <div class={sectionClass}>
                <h2 class={headingClass}>{group.heading}</h2>
                <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                  {group.items.map((item) => (
                    <li class={chipClass}>
                      <ProductIcon name={item.icon} />
                      {item.label}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
        {data.platformNote && (
          <p class="text-muted-foreground border-border m-0 border-t pt-4 text-sm">
            {data.platformNote}
          </p>
        )}
      </section>
    )}

    {data.skinTones && (
      <section class={sectionClass}>
        <h2 class={headingClass}>{ui.skinTonesHeading}</h2>
        <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
          {SKIN_TONE_CLASSES.map((toneClass, index) => (
            <li class="flex items-center gap-2 text-sm">
              <span
                class:list={[
                  toneClass,
                  'border-border size-7 rounded-full border',
                ]}
                aria-hidden="true"
              />
              {ui.skinTones[index]}
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.cards.length > 0 && (
      <section class:list={['reveal', revealClass(4), sectionClass]}>
        <h2 class={headingClass}>
          {isContribution ? ui.contributionHeading : ui.highlightsHeading}
        </h2>
        <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 min-[800px]:grid-cols-3">
          {data.cards.map((card) => (
            <li class={cardClass}>
              <ProductIcon name={card.icon} size={22} class="text-primary" />
              <h3 class="m-0 text-base font-semibold">{card.title}</h3>
              <p class="text-muted-foreground m-0 text-sm">{card.body}</p>
            </li>
          ))}
        </ul>
        {data.callout && (
          <div
            class="border-success/40 bg-success/10 rounded-card flex gap-3 border p-5"
            data-product-callout
          >
            <ProductIcon
              name={data.callout.icon}
              size={22}
              class="text-success mt-0.5"
            />
            <div class="flex flex-col gap-1">
              <h3 class="m-0 text-base font-semibold">{data.callout.title}</h3>
              <p class="text-muted-foreground m-0 text-sm">
                {data.callout.body}
              </p>
            </div>
          </div>
        )}
      </section>
    )}

    <section class:list={['reveal', revealClass(5), sectionClass]}>
      <h2 class={headingClass}>{ui.builtWithHeading}</h2>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {data.stack.map((item) => {
          const iconId = stackIconId(item)
          return (
            <li
              class:list={[
                'inline-flex min-h-9 items-center gap-2 rounded-md px-3 py-1 font-mono text-xs font-bold tracking-wider uppercase',
                stackBadgeClass(item),
              ]}
              data-product-badge
            >
              {iconId && (
                <span class="inline-flex size-5 items-center justify-center rounded-sm bg-white">
                  <ProductIcon name={iconId} size={14} />
                </span>
              )}
              {item}
            </li>
          )
        })}
      </ul>
    </section>

    {data.gallery.length > 0 && (
      <section class:list={['reveal', revealClass(6), sectionClass]}>
        <h2 class={headingClass}>{ui.galleryHeading}</h2>
        <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 min-[640px]:grid-cols-3">
          {data.gallery.map((shot) => (
            <li class="border-border rounded-card overflow-hidden border">
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={['avif', 'webp']}
                widths={[240, 480, 720]}
                sizes="(min-width: 640px) 33vw, 100vw"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.website && (
      <section class:list={['reveal', revealClass(7), sectionClass]}>
        <h2 class={headingClass}>{ui.websiteHeading}</h2>
        <figure
          class="border-border bg-card rounded-card m-0 overflow-hidden border"
          data-product-browser
        >
          <div
            class="border-border bg-muted flex items-center gap-3 border-b px-4 py-2"
            aria-hidden="true"
          >
            <span class="flex gap-1.5">
              <span class="bg-border size-2.5 rounded-full"></span>
              <span class="bg-border size-2.5 rounded-full"></span>
              <span class="bg-border size-2.5 rounded-full"></span>
            </span>
            <span class="bg-background text-muted-foreground rounded-pill min-w-0 flex-1 px-3 py-1 font-mono text-xs break-all">
              {data.website.host}
            </span>
          </div>
          <Picture
            src={data.website.src}
            alt={data.website.alt}
            formats={['avif', 'webp']}
            widths={[480, 720, 1200]}
            sizes="(min-width: 768px) 720px, 100vw"
            loading="lazy"
            class="w-full object-cover object-top"
          />
          <figcaption class="border-border border-t p-3">
            <a
              href={data.url}
              rel={externalLinkTokens()}
              class="bg-primary text-primary-foreground rounded-pill inline-flex min-h-11 items-center gap-2 px-5 py-2 font-mono text-sm no-underline hover:opacity-90"
              data-product-website={data.key}
              {...analyticsAttributes(ANALYTICS_EVENTS.productOpen, {
                product: data.key,
                link: 'website-tile',
              })}
            >
              <ProductIcon name="globe" />
              {fillPlaceholder(ui.websiteCaption, 'host', data.website.host)}
            </a>
          </figcaption>
        </figure>
      </section>
    )}

    <section class:list={['reveal', revealClass(8), sectionClass]}>
      <h2 class={headingClass}>
        {isContribution ? ui.contributionWhyHeading : ui.whyHeading}
      </h2>
      <div class="flex max-w-reading flex-col gap-3 [overflow-wrap:anywhere]">
        <Content />
      </div>
    </section>
  </article>
</BaseLayout>
