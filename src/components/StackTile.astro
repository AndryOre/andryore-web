---
import { resolveIcon } from '../lib/icons'
import {
  GLOW_CLASSES,
  sizeClass,
  type GlowIconId,
  type TileSize,
} from '../lib/stack-scene'
import BrandIcon from './BrandIcon.astro'

interface Props {
  id: GlowIconId
  size: TileSize
  class?: string
}

const { id, size, class: className } = Astro.props
const { light, dark } = resolveIcon(id)
const hasDarkMark = light !== dark
---

<span
  class:list={['stack-tile', sizeClass(size), GLOW_CLASSES[id], className]}
  aria-hidden="true"
>
  <BrandIcon id={id} class:list={[hasDarkMark && 'dark:hidden']} />
  {hasDarkMark && (
    <BrandIcon id={id} variant="dark" class="hidden dark:block" />
  )}
</span>
