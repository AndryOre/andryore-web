---
import LogEntryRoute from '../../../components/LogEntryRoute.astro'
import { getLogEntriesIn } from '../../../log/collection'

export async function getStaticPaths() {
  const entries = await getLogEntriesIn('es')
  return entries.map((entry) => ({
    params: { key: entry.key },
    props: { entry },
  }))
}

const { entry } = Astro.props
---

<LogEntryRoute lang="es" entry={entry} />
