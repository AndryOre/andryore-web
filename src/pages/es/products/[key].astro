---
import { getCollection } from 'astro:content'

import ProductPage from '../../../components/ProductPage.astro'
import type { ProductEntry } from '../../../lib/products'

export async function getStaticPaths() {
  const entries: ProductEntry[] = await getCollection('products')
  return entries
    .filter((entry) => entry.data.lang === 'es')
    .map((entry) => ({ params: { key: entry.data.key } }))
}

const { key } = Astro.params
---

<ProductPage locale="es" productKey={key} />
