---
import HomeBento from '../components/HomeBento.astro'
import StreamTile from '../components/StreamTile.astro'
import home from '../content/home.json'
import BaseLayout from '../layouts/BaseLayout.astro'

const { title, description } = home.en.meta
---

<BaseLayout title={title} description={description} locale="en" wide>
  <HomeBento locale="en">
    <StreamTile slot="stream" locale="en" />
  </HomeBento>
</BaseLayout>
