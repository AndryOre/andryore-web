---
import ClockTile from '../components/ClockTile.astro'
import GithubGridTile from '../components/GithubGridTile.astro'
import HomeBento from '../components/HomeBento.astro'
import home from '../content/home.json'
import BaseLayout from '../layouts/BaseLayout.astro'
import { loadGridSnapshot } from '../lib/github-grid-build'

const { title, description } = home.en.meta
const snapshot = await loadGridSnapshot()
---

<BaseLayout title={title} description={description} locale="en" wide>
  <HomeBento locale="en">
    <ClockTile slot="clock" locale="en" />
    {snapshot && (
      <GithubGridTile slot="github" locale="en" snapshot={snapshot} />
    )}
  </HomeBento>
</BaseLayout>
