{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2025"],
    "types": ["node", "bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "eslint-rules",
    "docs/adr",
    "docs/brand/tools",
    "scripts",
    ".github/**/*.ts"
  ],
  "exclude": ["node_modules", ".claude", ".forge"]
}
