{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2025"],
    "types": ["node", "bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src",
    ".astro/types.d.ts",
    "eslint-rules",
    "docs/adr",
    "docs/brand/tools",
    "docs/brand/tokens-contrast.test.ts",
    "scripts",
    ".github/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".claude", ".forge"]
}
