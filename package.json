{
  "name": "andryore-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "brand:export": "bun docs/brand/tools/export.mjs",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:visual": "bash scripts/visual.sh",
    "test:browsers": "bash scripts/browsers.sh",
    "test:smoke": "bash scripts/smoke.sh",
    "audit:dist": "bun scripts/audit-distribution.ts",
    "lint:commits": "bun scripts/lint-commits.ts",
    "ci:local": "bun install --frozen-lockfile && bun run lint:commits && bun run check && bun run lint:docs && bun run test",
    "format:check": "bunx --bun prettier --check \"**/*.{ts,tsx,js,jsx,mjs,astro,json,json5,md,css,yml,yaml}\" --cache",
    "format:write": "bunx --bun prettier --write \"**/*.{ts,tsx,js,jsx,mjs,astro,json,json5,md,css,yml,yaml}\" --cache",
    "lint": "eslint . --max-warnings=0 --cache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-strategy content",
    "typecheck": "astro check && tsc --noEmit",
    "knip": "knip",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:lighthouse": "bun scripts/lighthouse-budget.ts",
    "i18n:status": "bun scripts/i18n-status.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "fix": "bun run format:write && bun run lint:fix",
    "cache:clear": "rm -rf /tmp/node-compile-cache .eslintcache node_modules/.cache",
    "prepare": "bunx --bun husky",
    "grid:update": "bun scripts/update-github-grid.ts",
    "audit:fidelity": "bun scripts/fidelity-audit.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.64.0",
    "@shadcn/lint": "^0.2.1",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsdoc": "^65.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^77",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  }
}
